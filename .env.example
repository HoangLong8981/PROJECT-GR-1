# =============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Sao chép tệp này thành .env trước khi chạy: cp .env.example .env
# TUYỆT ĐỐI KHÔNG ĐƯA TỆP .env CHỨA MẬT KHẨU THẬT LÊN KHO MÃ NGUỒN GIT
# =============================================================================

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ChangeMe_StrongPassword_2026!
POSTGRES_DB=ecommerce_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432

# Cấu hình Lưu trữ đối tượng MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ChangeMe_MinioSecret_2026!
MINIO_ENDPOINT=minio-storage:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=product-images

# Cấu hình Ứng dụng
APP_ENV=production
DB_POOL_MIN=2
DB_POOL_MAX=20

# Cấu hình Grafana Monitoring
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe_Grafana_2026!
